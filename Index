<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Detective Files: Lincoln — Nocturne</title>
    <style>
        /* ─── BASE RESET ─── */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        html,
        body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #070b12;
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #e2e8f0;
            user-select: none;
        }

        /* ─── SCENE WRAPPER ─── */
        .scene-wrapper {
            position: relative;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
        }

        /* ─── SCENE 1: STICKMAN ─── */
        #scene-stickman {
            position: absolute;
            inset: 0;
            z-index: 10;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: #070b12;
            transition: opacity 1.2s ease, transform 1.2s ease;
            opacity: 1;
            transform: scale(1);
            pointer-events: auto;
        }
        #scene-stickman.hidden {
            opacity: 0;
            transform: scale(0.96);
            pointer-events: none;
        }

        .header {
            text-align: center;
            z-index: 10;
            pointer-events: none;
        }
        #main-title {
            font-size: 38px;
            font-weight: 300;
            letter-spacing: 6px;
            text-transform: uppercase;
            color: #f1f5f9;
            text-shadow: 0 0 30px rgba(59, 130, 246, 0.3), 0 4px 12px rgba(0, 0, 0, 0.6);
            opacity: 0;
            transform: translateY(30px);
            animation: fadeUp 0.8s ease forwards;
            animation-delay: 0.4s;
        }
        @keyframes fadeUp {
            0% {
                opacity: 0;
                transform: translateY(30px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .title-line {
            width: 160px;
            height: 2px;
            background: linear-gradient(90deg, transparent, #3b82f6, transparent);
            margin: 8px auto 0;
            opacity: 0;
            animation: fadeIn 1s ease forwards;
            animation-delay: 1.0s;
        }
        @keyframes fadeIn {
            0% {
                opacity: 0;
                transform: scaleX(0.8);
            }
            100% {
                opacity: 0.5;
                transform: scaleX(1);
            }
        }

        #heistCanvas {
            background-color: #0b111e;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.9);
            border-radius: 18px;
            border: 1px solid #1e293b;
            display: block;
            width: 800px;
            height: 500px;
            max-width: 98vw;
            max-height: 70vh;
            flex-shrink: 0;
        }

        .footer {
            text-align: center;
            z-index: 10;
            pointer-events: none;
            margin-top: 4px;
        }

        /* ─── SMOOTH LETTER ANIMATION ─── */
        #sub-title {
            display: flex;
            gap: 6px;
            justify-content: center;
            font-size: 32px;
            font-weight: 400;
            letter-spacing: 4px;
            color: #cbd5e1;
        }

        .letter {
            display: inline-block;
            opacity: 0;
            transform: translateY(24px) scale(0.85);
            will-change: transform, opacity, text-shadow;
            animation: letterEntrance 1.0s cubic-bezier(0.22, 0.61, 0.36, 1) forwards,
                letterRipple 3.2s ease-in-out infinite;
            animation-delay: var(--delay, 2.2s), calc(var(--delay, 2.2s) + 1.0s);
        }

        .letter:first-child {
            color: #ef4444;
            text-shadow: 0 0 30px rgba(239, 68, 68, 0.5);
        }
        .letter:first-child .letterRipple {
            text-shadow: 0 0 30px rgba(239, 68, 68, 0.7), 0 0 60px rgba(239, 68, 68, 0.2);
        }

        @keyframes letterEntrance {
            0% {
                opacity: 0;
                transform: translateY(28px) scale(0.75);
                letter-spacing: 12px;
                text-shadow: 0 0 0 transparent;
            }
            50% {
                opacity: 1;
                transform: translateY(-3px) scale(1.04);
                letter-spacing: 2px;
                text-shadow: 0 0 25px rgba(59, 130, 246, 0.3);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
                letter-spacing: 2px;
                text-shadow: 0 0 0 transparent;
            }
        }

        @keyframes letterRipple {
            0% {
                transform: translateY(0) scale(1);
                text-shadow: 0 0 0 transparent;
            }
            15% {
                transform: translateY(-5px) scale(1.05);
                text-shadow: 0 0 18px rgba(59, 130, 246, 0.35);
            }
            30% {
                transform: translateY(0) scale(1);
                text-shadow: 0 0 0 transparent;
            }
            45% {
                transform: translateY(-3px) scale(1.03);
                text-shadow: 0 0 12px rgba(59, 130, 246, 0.25);
            }
            60% {
                transform: translateY(0) scale(1);
                text-shadow: 0 0 0 transparent;
            }
            80% {
                transform: translateY(-2px) scale(1.01);
                text-shadow: 0 0 6px rgba(59, 130, 246, 0.15);
            }
            100% {
                transform: translateY(0) scale(1);
                text-shadow: 0 0 0 transparent;
            }
        }

        /* ─── SCENE 2: NOCTURNE ─── */
        #scene-nocturne {
            position: absolute;
            inset: 0;
            z-index: 5;
            opacity: 0;
            transition: opacity 1.8s ease;
            pointer-events: none;
            background: #07080b;
            overflow: hidden;
        }
        #scene-nocturne.active {
            opacity: 1;
            pointer-events: auto;
            z-index: 20;
        }

        /* ─── NOCTURNE STYLES ─── */
        .room {
            position: relative;
            width: 100vw;
            height: 100vh;
            background: radial-gradient(ellipse at 50% 40%, #191e28 0%, #0c0e14 55%, #040507 100%);
            overflow: hidden;
        }
        .room::before {
            content: '';
            position: absolute;
            inset: 0;
            background: repeating-linear-gradient(90deg,
                    rgba(255, 255, 255, .008) 0px,
                    rgba(255, 255, 255, .008) 1px,
                    transparent 1px,
                    transparent 70px);
            pointer-events: none;
            z-index: 1;
        }

        .window-wrapper {
            position: absolute;
            left: 50%;
            top: 12vh;
            transform: translateX(-50%);
            width: 60vw;
            max-width: 740px;
            height: 38vh;
            max-height: 360px;
            z-index: 3;
            filter: drop-shadow(0 20px 50px rgba(0, 0, 0, .85));
        }
        .window-frame {
            position: relative;
            width: 100%;
            height: 100%;
            background: #1e1712;
            padding: 14px;
            border-radius: 6px;
            box-shadow: inset 0 0 30px rgba(0, 0, 0, .6), 0 0 0 2px #2d221a, 0 0 0 5px #1a1410;
        }
        .window-glass {
            position: relative;
            width: 100%;
            height: 100%;
            background: #0b0e17;
            overflow: hidden;
            border-radius: 2px;
            box-shadow: inset 0 0 60px rgba(0, 0, 0, .7);
        }

        /* ─── WINDOW VIDEO ─── */
        .window-video {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 0;
            display: block;
        }
        .window-image-fallback {
            position: absolute;
            inset: 0;
            z-index: 0;
            background: linear-gradient(180deg, #0a0e1a 0%, #151e30 40%, #1a2440 70%, #0f1425 100%);
            display: none;
        }
        .window-image-fallback.visible {
            display: block;
        }

        .glass-reflection {
            position: absolute;
            inset: 0;
            z-index: 7;
            pointer-events: none;
            background: linear-gradient(135deg,
                    rgba(255, 255, 255, .015) 0%,
                    transparent 30%,
                    transparent 70%,
                    rgba(255, 255, 255, .01) 100%);
            mix-blend-mode: overlay;
        }

        .mullions {
            position: absolute;
            inset: 0;
            z-index: 6;
            pointer-events: none;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            grid-template-rows: repeat(3, 1fr);
            gap: 0;
        }
        .mullion-h {
            position: absolute;
            left: 0;
            right: 0;
            height: 4px;
            background: #1a1410;
            box-shadow: 0 0 8px rgba(0, 0, 0, .5);
            z-index: 6;
            pointer-events: none;
        }
        .mullion-v {
            position: absolute;
            top: 0;
            bottom: 0;
            width: 4px;
            background: #1a1410;
            box-shadow: 0 0 8px rgba(0, 0, 0, .5);
            z-index: 6;
            pointer-events: none;
        }
        .mullion-h-1 {
            top: 33.33%;
        }
        .mullion-h-2 {
            top: 66.66%;
        }
        .mullion-v-1 {
            left: 25%;
        }
        .mullion-v-2 {
            left: 50%;
        }
        .mullion-v-3 {
            left: 75%;
        }

        .frame-corner {
            position: absolute;
            width: 20px;
            height: 20px;
            border: 2.5px solid #3d2e22;
            z-index: 8;
            pointer-events: none;
            opacity: 0.5;
        }
        .frame-corner.tl {
            top: 5px;
            left: 5px;
            border-right: none;
            border-bottom: none;
        }
        .frame-corner.tr {
            top: 5px;
            right: 5px;
            border-left: none;
            border-bottom: none;
        }
        .frame-corner.bl {
            bottom: 5px;
            left: 5px;
            border-right: none;
            border-top: none;
        }
        .frame-corner.br {
            bottom: 5px;
            right: 5px;
            border-left: none;
            border-top: none;
        }

        .desk {
            position: absolute;
            left: 50%;
            bottom: 0;
            transform: translateX(-50%) perspective(700px) rotateX(3deg);
            transform-origin: bottom center;
            width: 74vw;
            max-width: 900px;
            height: 25vh;
            max-height: 240px;
            z-index: 10;
        }
        .table-top {
            position: absolute;
            bottom: 52%;
            left: -2%;
            right: -2%;
            height: 28%;
            background: linear-gradient(135deg, #2d1a10, #3d2619 40%, #2d1a10);
            border-radius: 2px 2px 0 0;
            box-shadow: inset 0 8px 25px rgba(0, 0, 0, .6), inset 0 -4px 15px rgba(0, 0, 0, .4),
                0 -6px 30px rgba(0, 0, 0, .5);
            transform: rotateX(0deg);
            transform-origin: bottom center;
        }
        .table-top::after {
            content: '';
            position: absolute;
            inset: 0;
            opacity: .15;
            background: repeating-linear-gradient(4deg,
                    transparent 0px,
                    transparent 25px,
                    #000 26px,
                    transparent 28px);
            pointer-events: none;
            border-radius: 2px 2px 0 0;
        }
        .table-top::before {
            content: '';
            position: absolute;
            top: -1px;
            left: 6%;
            right: 6%;
            height: 2px;
            background: linear-gradient(90deg, transparent, rgba(200, 170, 130, .12), transparent);
            border-radius: 50%;
            pointer-events: none;
        }
        .legs {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 52%;
            z-index: 0;
        }
        .leg {
            position: absolute;
            bottom: 0;
            width: 4.5%;
            max-width: 36px;
            height: 100%;
            background: linear-gradient(90deg, #1a100c, #2d1a10, #1a100c);
            border-radius: 0 0 3px 3px;
            box-shadow: inset -2px 0 8px rgba(0, 0, 0, .5), 0 8px 20px rgba(0, 0, 0, .7);
        }
        .leg::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: -2px;
            right: -2px;
            height: 4px;
            background: linear-gradient(90deg, #1a100c, #3d2619, #1a100c);
            border-radius: 0 0 2px 2px;
        }
        .leg-1 {
            left: 4%;
        }
        .leg-2 {
            left: 22%;
        }
        .leg-3 {
            right: 22%;
        }
        .leg-4 {
            right: 4%;
        }
        .leg-brace {
            position: absolute;
            bottom: 18%;
            left: 8%;
            right: 8%;
            height: 2.5px;
            background: linear-gradient(90deg, transparent, #2d1a10 20%, #2d1a10 80%, transparent);
            border-radius: 2px;
            opacity: 0.4;
            box-shadow: 0 2px 6px rgba(0, 0, 0, .3);
        }

        .lamp {
            position: absolute;
            left: 62%;
            bottom: 75%;
            width: 150px;
            height: 200px;
            z-index: 15;
            transform-origin: bottom center;
        }
        .lamp-base {
            position: absolute;
            bottom: 0;
            left: 18px;
            width: 110px;
            height: 18px;
            border-radius: 50%;
            background: linear-gradient(#2d2f33, #0f1013);
            box-shadow: 0 10px 20px rgba(0, 0, 0, .8), inset 0 2px 5px rgba(255, 255, 255, .08);
        }
        .lamp-stand {
            position: absolute;
            bottom: 14px;
            left: 70px;
            width: 9px;
            height: 120px;
            background: linear-gradient(90deg, #111, #4d4d4d, #181818);
            border-radius: 6px;
            transform: rotate(3deg);
            transform-origin: bottom;
            box-shadow: inset -1px 0 5px rgba(0, 0, 0, .4);
        }
        .lamp-arm {
            position: absolute;
            width: 85px;
            height: 9px;
            left: 58px;
            top: 38px;
            background: linear-gradient(#111, #4a4a4a, #111);
            border-radius: 6px;
            transform: rotate(-18deg);
            box-shadow: inset 0 2px 4px rgba(255, 255, 255, .05);
        }
        .lamp-shade {
            position: absolute;
            top: 10px;
            left: 6px;
            width: 95px;
            height: 62px;
            background: linear-gradient(90deg, #1a1a1a, #3a3a3a, #1a1a1a);
            clip-path: polygon(18% 0, 82% 0, 100% 100%, 0 100%);
            filter: drop-shadow(0 8px 10px rgba(0, 0, 0, .7));
            transform: rotate(-8deg);
            z-index: 3;
        }
        .lamp-shade::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: #0a0a0a;
            border-radius: 0 0 2px 2px;
        }
        .shade-glow {
            position: absolute;
            top: 4px;
            left: 20%;
            right: 20%;
            height: 18px;
            background: radial-gradient(ellipse at center, rgba(255, 200, 120, .15), transparent 70%);
            border-radius: 50%;
            opacity: 0;
            transition: opacity 0.4s ease;
            pointer-events: none;
        }
        .shade-glow.on {
            opacity: 1;
        }
        .lamp-bulb {
            position: absolute;
            width: 24px;
            height: 26px;
            left: 46px;
            top: 48px;
            border-radius: 50% 50% 45% 45%;
            background: radial-gradient(circle, #444, #1a1a1a);
            box-shadow: none;
            z-index: 2;
            transition: background 0.3s ease, box-shadow 0.3s ease;
        }
        .lamp-bulb.on {
            background: radial-gradient(circle, #fffbd4 0%, #ffd66b 25%, #d47b21 55%, #4c2408 100%);
            box-shadow: 0 0 8px #ffd56b, 0 0 22px #ffbd48, 0 0 45px #ff9d2e;
            animation: bulbFlicker 4.8s infinite;
        }
        @keyframes bulbFlicker {
            0%,
            85%,
            100% {
                opacity: 1;
                box-shadow: 0 0 8px #ffd56b, 0 0 22px #ffbd48, 0 0 45px #ff9d2e;
            }
            86% {
                opacity: .78;
                box-shadow: 0 0 5px #ffd56b, 0 0 14px #ffbd48, 0 0 26px #ff9d2e;
            }
            87% {
                opacity: 1;
                box-shadow: 0 0 10px #ffd56b, 0 0 26px #ffbd48, 0 0 50px #ff9d2e;
            }
            88% {
                opacity: .55;
                box-shadow: 0 0 3px #ffd56b, 0 0 8px #ffbd48, 0 0 16px #ff9d2e;
            }
            89% {
                opacity: 1;
                box-shadow: 0 0 8px #ffd56b, 0 0 22px #ffbd48, 0 0 45px #ff9d2e;
            }
            91% {
                opacity: .7;
                box-shadow: 0 0 4px #ffd56b, 0 0 12px #ffbd48, 0 0 22px #ff9d2e;
            }
            92% {
                opacity: 1;
                box-shadow: 0 0 8px #ffd56b, 0 0 22px #ffbd48, 0 0 45px #ff9d2e;
            }
        }
        .light-glow {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: radial-gradient(circle,
                    rgba(255, 210, 130, 0.35) 0%,
                    rgba(255, 180, 90, 0.12) 35%,
                    rgba(255, 150, 60, 0.04) 60%,
                    transparent 80%);
            z-index: 1;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.6s ease;
            mix-blend-mode: screen;
            filter: blur(12px);
        }
        .light-glow.on {
            opacity: 1;
            animation: glowPulse 4.8s infinite;
        }
        @keyframes glowPulse {
            0%,
            85%,
            100% {
                opacity: 1;
            }
            86% {
                opacity: .7;
            }
            88% {
                opacity: .5;
            }
            89% {
                opacity: 1;
            }
            91% {
                opacity: .7;
            }
            92% {
                opacity: 1;
            }
        }
        .table-glow {
            position: absolute;
            bottom: 0;
            left: 15%;
            right: 0;
            height: 45%;
            background: radial-gradient(ellipse at 65% 100%,
                    rgba(255, 200, 140, .0) 0%,
                    rgba(255, 200, 140, .0) 40%,
                    transparent 70%);
            pointer-events: none;
            z-index: 5;
            transition: opacity 0.6s ease;
            opacity: 0;
        }
        .table-glow.on {
            background: radial-gradient(ellipse at 65% 100%,
                    rgba(255, 200, 140, .12) 0%,
                    rgba(255, 180, 120, .05) 40%,
                    transparent 70%);
            opacity: 1;
            animation: deskGlowPulse 4.8s infinite;
        }
        @keyframes deskGlowPulse {
            0%,
            85%,
            100% {
                opacity: 1;
            }
            86% {
                opacity: .7;
            }
            88% {
                opacity: .5;
            }
            89% {
                opacity: 1;
            }
            91% {
                opacity: .7;
            }
            92% {
                opacity: 1;
            }
        }
        .chain {
            position: absolute;
            left: 50px;
            top: 60px;
            width: 2.5px;
            height: 44px;
            background: repeating-linear-gradient(to bottom,
                    #b78b4b 0,
                    #b78b4b 3.5px,
                    transparent 3.5px,
                    transparent 7px);
            z-index: 20;
            cursor: pointer;
            transition: height .15s ease, transform .15s ease;
        }
        .chain:hover {
            height: 50px;
        }
        .chain-ball {
            position: absolute;
            bottom: -10px;
            left: -5px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: radial-gradient(circle at 30% 30%, #fff, #c89954 30%, #5b3a18 80%);
            box-shadow: 0 3px 6px rgba(0, 0, 0, .6);
        }
        .chain.pull {
            transform: translateY(8px);
            transition: transform .12s ease;
        }
        .dust {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 25;
            opacity: 0.4;
            transition: opacity 0.8s ease;
        }
        .dust.off {
            opacity: 0.06;
        }
        .particle {
            position: absolute;
            width: 3px;
            height: 3px;
            border-radius: 50%;
            background: rgba(255, 220, 150, .5);
            animation: floatDust linear infinite;
        }
        @keyframes floatDust {
            from {
                transform: translate(0, 30px) scale(1);
                opacity: 0;
            }
            20% {
                opacity: .7;
            }
            80% {
                opacity: .4;
            }
            to {
                transform: translate(60px, -150px) scale(0.5);
                opacity: 0;
            }
        }
        .ui-menu {
            position: absolute;
            top: 62vh;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 50;
            text-align: center;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.6s ease;
            width: auto;
            user-select: none;
        }
        .room:not(.off) .ui-menu {
            opacity: 1;
            pointer-events: auto;
        }
        .ui-menu .item-wrap {
            margin: 8px 0;
        }
        .ui-menu .item {
            display: inline-block;
            padding: 10px 32px;
            min-width: 180px;
            border: 1px solid rgba(215, 180, 119, 0.15);
            border-radius: 4px;
            background: rgba(10, 8, 10, 0.3);
            backdrop-filter: blur(2px);
            color: #d7b477;
            font-size: clamp(16px, 1.6vw, 24px);
            letter-spacing: 6px;
            text-transform: uppercase;
            text-decoration: none;
            font-family: 'Georgia', serif;
            font-weight: 400;
            text-shadow: 0 0 30px rgba(0, 0, 0, 0.9), 0 0 60px rgba(0, 0, 0, 0.6);
            transition: all 0.3s ease;
            cursor: pointer;
            pointer-events: auto;
            outline: none;
            user-select: none;
        }
        .ui-menu .item:focus,
        .ui-menu .item:active,
        .ui-menu .item:focus-visible {
            outline: none;
            box-shadow: none;
        }
        .room.off .ui-menu .item {
            pointer-events: none;
            outline: none;
        }
        .ui-menu .item:hover {
            border-color: rgba(215, 180, 119, 0.6);
            background: rgba(20, 15, 20, 0.7);
            color: #f0e6d0;
            transform: scale(1.04);
            text-shadow: 0 0 40px rgba(215, 180, 119, 0.15);
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.3);
        }
        .ui-title {
            position: absolute;
            top: 3%;
            right: 5%;
            color: #d7b477;
            font-size: clamp(18px, 2.4vw, 38px);
            letter-spacing: 10px;
            text-shadow: 0 2px 20px rgba(0, 0, 0, .9);
            z-index: 50;
            font-weight: 700;
        }
        .ui-sub {
            position: absolute;
            top: 9%;
            right: 5%;
            color: #8a7a6a;
            letter-spacing: 5px;
            font-size: clamp(8px, 0.8vw, 12px);
            z-index: 50;
